{
  "name": "@nat-ui/cli",
  "version": "0.0.0",
  "description": "Add nat-ui components to your project.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Natip85/nat-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Natip85/nat-ui#readme",
  "bugs": "https://github.com/Natip85/nat-ui/issues",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "nat-ui",
    "components",
    "ui",
    "tailwindcss",
    "react"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "bin": {
    "nat-ui": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@nat-ui/schema": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
