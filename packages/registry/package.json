{
  "name": "@nat-ui/registry",
  "version": "0.0.0",
  "description": "Canonical source for every nat-ui component, plus the typed registry definition.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsx scripts/build-registry.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./registry": "./src/index.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./lib/motion": "./src/lib/motion.ts",
    "./lib/use-motion": "./src/lib/use-motion.ts",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@nat-ui/schema": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
